::SCORE::
** Nested Canon in D (Macro S-Expression Syntax) **
~ "composer: Johann Pachelbel"
~ "concept: Nested Canon Macro Demo in TMD"
!= 68
?= D
<4/4>

/* ==========================================================================
   1. 抽象主題宣告 (Abstract Material)
   完全不綁定樂器，純粹的動機素材
   ========================================================================== */

/* 固定低音 (2 小節和弦循環) */
Bass {
    <4*>
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
}

/* 主題 A (4 小節) */
ThemeA {
    <4*>
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
}

/* 變奏 1 (四分音符級進，4 小節) */
Var1 {
    <4*>
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 | 2 7, 1 2 |
}

/* 變奏 2 (八分音符流暢跑動，4 小節) */
Var2 {
    <4*>
    1' 7 1' 2' | 3' 2' 1' 7 | 6 5 6 7 | 1' 7 1' 2' |
}

/* ==========================================================================
   2. 巢狀卡農巨集播放表達式 (Nested Canon S-Expression)
   - 內層卡農：由小提琴雙重奏 (Violin1 Violin2) 間隔 1 小節緊密追逐
   - 外層卡農：在 4 小節後，由長笛雙重奏 (Flute1 Flute2) 整體進場追逐
   - 底層伴奏：大提琴演奏固定低音循環 8 次
   ========================================================================== */

-> (layer
     (loop Bass Cello 8)
     (canon
       (canon (ThemeA Var1 Var2) (Violin1 Violin2) 1)
       (Flute1 Flute2)
       4
     )
   ) ->#
