::SCORE::
** Canon in D **
~ "composer: Johann Pachelbel"
!= 56
?= D
<4/4>

/* ==========================================================================
   Section 1: 前奏 (Basso Continuo 率先進場，鋪陳 2 小節固定低音)
   ========================================================================== */
intro:Cello@|0|{
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* ==========================================================================
   Section 2: 主體卡農 (三把小提琴依序間隔 2 小節嚴格卡農對位，大提琴維持固定低音循環)
   
   【依據 Mutopia Project / IMSLP 帕海貝爾原始總譜 (Canon per 3 Violini e Basso)】
   調性：D 大調 (?= D), 1=D4, 2=E4, 3=F#4, 4=G4, 5=A4, 6=B4, 7=C#5
   
   - Theme (四分音符主題, bars 1-4):
     fis4 e d cis | b a b cis | d cis b a | g fis g e |
     TMD: 3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |
     
   - Variation 1 (八分音符級進與跳進, bars 5-8):
     d8 fis a g fis d fis e | d b d a' g b a g | fis d e cis' d fis a a, | b g a fis d d' d8. cis16 |
     TMD: 1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 | 3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |
     
   - Variation 2 (十六分音符流動旋律, bars 9-12):
     d16 cis d d, cis a' e fis d d' cis b cis fis a b | g fis e g fis e d cis b a g fis e g fis e |
     d e fis g a e a g fis b a g a g fis e | d b b' cis d cis b a g fis e b' a b a g |
     TMD:
     1^ 7 1^ 1 7_ 5 2 3 1 1^ 7 6 7 3 5 6 |
     4 3 2 4 3 2 1 7_ 6_ 5_ 4_ 3_ 2_ 4_ 3_ 2_ |
     1_ 2_ 3_ 4_ 5_ 2_ 5_ 4_ 3_ 6_ 5_ 4_ 5_ 4_ 3_ 2_ |
     1_ 6__ 6_ 7_ 1 7_ 6_ 5_ 4_ 3_ 2_ 6_ 5_ 6_ 5_ 4_ |
   ========================================================================== */

/* 大提琴：持續演奏 16 小節固定低音進行 (D3 A2 B2 F#2 | G2 D2 G2 A2) */
canon:Cello@|0|{
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* 第一小提琴 (Voice 1)：@|0| 進入正統帕海貝爾主題與後續變奏 */
canon:Violin1@|0|{
    <4*>
    /* 原譜四分音符主題 (bars 1-4) */
    3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |

    /* 原譜八分音符變奏 1 (bars 5-8) */
    <8*>
    1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 |
    3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |

    /* 原譜十六分音符變奏 2 (bars 9-12) */
    <16*>
    1^ 7 1^ 1  7_ 5 2 3  1 1^ 7 6  7 3 5 6 |
    4 3 2 4  3 2 1 7_  6_ 5_ 4_ 3_  2_ 4_ 3_ 2_ |
    1_ 2_ 3_ 4_  5_ 2_ 5_ 4_  3_ 6_ 5_ 4_  5_ 4_ 3_ 2_ |
    1_ 6__ 6_ 7_  1 7_ 6_ 5_  4_ 3_ 2_ 6_  5_ 6_ 5_ 4_ |
}

/* 第二小提琴 (Voice 2)：延遲 2 個小節 (@|+2|) 進入完全相同旋律 */
canon:Violin2@|+2|{
    <4*>
    /* 原譜四分音符主題 */
    3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |

    /* 原譜八分音符變奏 1 */
    <8*>
    1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 |
    3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |

    /* 原譜十六分音符變奏 2 */
    <16*>
    1^ 7 1^ 1  7_ 5 2 3  1 1^ 7 6  7 3 5 6 |
    4 3 2 4  3 2 1 7_  6_ 5_ 4_ 3_  2_ 4_ 3_ 2_ |
    1_ 2_ 3_ 4_  5_ 2_ 5_ 4_  3_ 6_ 5_ 4_  5_ 4_ 3_ 2_ |
    1_ 6__ 6_ 7_  1 7_ 6_ 5_  4_ 3_ 2_ 6_  5_ 6_ 5_ 4_ |
}

/* 第三小提琴 (Voice 3)：延遲 4 個小節 (@|+4|) 進入完全相同旋律 */
canon:Violin3@|+4|{
    <4*>
    /* 原譜四分音符主題 */
    3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |

    /* 原譜八分音符變奏 1 */
    <8*>
    1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 |
    3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |

    /* 原譜十六分音符變奏 2 */
    <16*>
    1^ 7 1^ 1  7_ 5 2 3  1 1^ 7 6  7 3 5 6 |
    4 3 2 4  3 2 1 7_  6_ 5_ 4_ 3_  2_ 4_ 3_ 2_ |
    1_ 2_ 3_ 4_  5_ 2_ 5_ 4_  3_ 6_ 5_ 4_  5_ 4_ 3_ 2_ |
    1_ 6__ 6_ 7_  1 7_ 6_ 5_  4_ 3_ 2_ 6_  5_ 6_ 5_ 4_ |
}

/* ==========================================================================
   Section 3: 尾奏 (三把小提琴與大提琴終止於 D 大調主和弦音)
   ========================================================================== */
outro:Violin1@|0|{
    <1*>
    1^--- |
}

outro:Violin2@|0|{
    <1*>
    3--- |
}

outro:Violin3@|0|{
    <1*>
    1--- |
}

outro:Cello@|0|{
    <1*>
    1_--- |
}

/* ==========================================================================
   播放流程 (Playback Arrangement)
   ========================================================================== */
-> intro -> canon -> outro ->#
