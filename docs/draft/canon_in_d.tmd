::SCORE::
** Canon in D **
~ "composer: Johann Pachelbel"
!= 68
?= D
<4/4>

/* ==========================================================================
   Section 1: 前奏 (Basso Continuo 率先進場，鋪陳 2 小節固定低音)
   ========================================================================== */
intro:Cello@|0|{
    <4*>
    1, - 5,, - | 6,, - 3,, - |
}

intro:CHORD@|0|{
    <2*>
    [1] [5] | [6m] [3m] |
}

/* ==========================================================================
   Section 2: 主體卡農 (三把小提琴依序間隔 2 小節進場，大提琴維持固定低音)
   ========================================================================== */

/* 大提琴：持續演奏 8 小節固定低音進行 (D - A - Bm - F#m - G - D - G - A) */
canon:Cello@|0|{
    <4*>
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
}

/* 和弦聲部 */
canon:CHORD@|0|{
    <2*>
    [1] [5] | [6m] [3m] | [4] [1] | [4] [5] |
    [1] [5] | [6m] [3m] | [4] [1] | [4] [5] |
}

/* 第一小提琴 (Voice 1)：@|0| 準時進入主題與後續變奏 */
canon:Violin1@|0|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 | 2 7, 1 2 |
}

/* 第二小提琴 (Voice 2)：延遲 2 個小節 (@|+2|) 進入一模一樣的旋律 */
canon:Violin2@|+2|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, |
}

/* 第三小提琴 (Voice 3)：再延遲 2 個小節 (@|+4|) 追逐進場 */
canon:Violin3@|+4|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
}

/* ==========================================================================
   Section 3: 尾奏 (收尾於 D 大調主和弦)
   ========================================================================== */
outro:Violin1@|0|{
    <1*>
    1'---
}

outro:Violin2@|0|{
    <1*>
    3---
}

outro:Violin3@|0|{
    <1*>
    5,---
}

outro:Cello@|0|{
    <1*>
    1,,---
}

outro:CHORD@|0|{
    <1*>
    [1]---
}

/* ==========================================================================
   播放流程 (Playback Arrangement)
   ========================================================================== */
-> intro -> canon -> outro ->#
