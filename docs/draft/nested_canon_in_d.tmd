::SCORE::
** Nested Canon in D (Double Stretto) **
~ "composer: Johann Pachelbel"
~ "concept: Nested / Polychoral Canon in TMD"
!= 68
?= D
<4/4>

/* ==========================================================================
   Section 1: 前奏 (大提琴固定低音進場)
   ========================================================================== */
intro:Cello@|0|{
    <4*>
    1, - 5,, - | 6,, - 3,, - |
}

intro:CHORD@|0|{
    <2*>
    [1] [5] | [6m] [3m] |
}

/* ==========================================================================
   Section 2: 巢狀卡農主體 (Nested Canon)
   - 內層微觀卡農 (Micro-Canon)：小提琴組 Violin1 與 Violin2 間隔 1 小節緊密追逐 (Stretto)
   - 外層宏觀卡農 (Macro-Canon)：長笛組 Flute1 與 Flute2 延遲 4 小節後，以相同對位結構加入複音追逐
   - 底層大提琴持續演奏固定低音 (Ground Bass)
   ========================================================================== */

/* 大提琴固定低音 (持續 12 小節) */
canon:Cello@|0|{
    <4*>
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
    1, - 5,, - | 6,, - 3,, - | 4,, - 1,, - | 4,, - 5,, - |
}

/* 和弦背景 (持續 12 小節) */
canon:CHORD@|0|{
    <2*>
    [1] [5] | [6m] [3m] | [4] [1] | [4] [5] |
    [1] [5] | [6m] [3m] | [4] [1] | [4] [5] |
    [1] [5] | [6m] [3m] | [4] [1] | [4] [5] |
}

/* --------------------------------------------------------------------------
   Group A (弦樂組微觀卡農：進場時間差 1 小節)
   -------------------------------------------------------------------------- */

/* 第一小提琴 (Voice A1): @|0| 準時起奏 */
canon:Violin1@|0|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 | 2 7, 1 2 |
    /* 變奏 2 (流暢八分音符) */
    1' 7 1' 2' | 3' 2' 1' 7 | 6 5 6 7 | 1' 7 1' 2' |
}

/* 第二小提琴 (Voice A2): 緊跟在 1 小節後 (@|+1|) 進入相同旋律 */
canon:Violin2@|+1|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 | 2 7, 1 2 |
    /* 變奏 2 (流暢八分音符) */
    1' 7 1' 2' | 3' 2' 1' 7 | 6 5 6 7 |
}

/* --------------------------------------------------------------------------
   Group B (木管組宏觀卡農：整體在 4 小節後展開，內部同樣間隔 1 小節)
   -------------------------------------------------------------------------- */

/* 第一長笛 (Voice B1): 在 @|+4| 展開第二波對位主浪潮 */
canon:Flute1@|+4|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 | 2 7, 1 2 |
}

/* 第二長笛 (Voice B2): 再延遲 1 小節 (@|+5|)，緊隨第一長笛 */
canon:Flute2@|+5|{
    <4*>
    /* 主題陳述 */
    1' - 7 - | 6 - 5 - | 4 - 3 - | 4 - 5 - |
    /* 變奏 1 (四分音符級進) */
    3 1 2 7, | 1 6, 1 5, | 6, 4, 5, 1 |
}

/* ==========================================================================
   Section 3: 尾奏收束 (全體回歸 D 大調主和弦)
   ========================================================================== */
outro:Violin1@|0|{
    <1*>
    1'---
}

outro:Violin2@|0|{
    <1*>
    3---
}

outro:Flute1@|0|{
    <1*>
    5---
}

outro:Flute2@|0|{
    <1*>
    1'---
}

outro:Cello@|0|{
    <1*>
    1,,---
}

outro:CHORD@|0|{
    <1*>
    [1]---
}

/* ==========================================================================
   播放序列
   ========================================================================== */
-> intro -> canon -> outro ->#
