/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 3_ - - - | 5_ - - - | 2_ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }
outro:Violin4@|0|{ <1*> 1^--- | }
outro:Violin5@|0|{ <1*> 5--- | }

/* S-Expression Playback Flow */
-> intro
-> (layer
     (canon (Theme Var1 Var2 Var3 Var4 Var5 Var6 Var7 Var8 Var9 Var10 Var11 Var12 Var13 Var14) (Violin1 Violin2 Violin3 Violin4 Violin5) 4)
     (loop Bass Cello 19))
-> outro
->#
