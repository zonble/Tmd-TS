/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 6__ - - - | 1_ - - - |
}

outro:Cello@|0|{ <1*> 6__--- | }
outro:Violin1@|0|{ <1*> 6--- | }
outro:Violin2@|0|{ <1*> 1--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow */
-> intro
-> (layer
     (canon (Theme Var1 Var2 Var3 Var4 Var5 Var6 Var7 Var8 Var9) (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 11))
-> outro
->#
