    | 3 1 3 1 |
    | 3 2 3 2 |
    | 2^ 3^ 6^ 6^ |
    | 3 2 6_ 2 |
    | 3^ 1^ 3^ 5^ |
    | 1^ 6 3 5 |
    | 5 6 1^ 3^ |
    | 3 3 6 3 |
}

