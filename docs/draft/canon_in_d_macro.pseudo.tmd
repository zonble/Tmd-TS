::SCORE::
** Canon in D (Macro S-Expression Prototype) **
~ "composer: Johann Pachelbel"
~ "arranger: Macro S-Expression Demonstration"
!= 56
?= D
<4/4>

/* ==========================================================================
   Abstract Prototypes (Macros / Themes)
   These paragraphs are not tied to any concrete instrument or timeline track.
   They serve as the single source of truth for melodic and bass motifs.
   ========================================================================== */

/* 固定低音原型 (Ground Bass / Basso Ostinato, 2 小節) */
Bass {
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* 小提琴共同主題與變奏群原型 (12 小節) */
Theme {
    <4*>
    /* 主題陳述 (bars 1-4) */
    3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |

    /* 變奏 1 (八分音符級進與跳進, bars 5-8) */
    <8*>
    1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 |
    3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |

    /* 變奏 2 (十六分音符流動旋律, bars 9-12) */
    <16*>
    1^ 7 1^ 1  7_ 5 2 3  1 1^ 7 6  7 3 5 6 |
    4 3 2 4  3 2 1 7_  6_ 5_ 4_ 3_  2_ 4_ 3_ 2_ |
    1_ 2_ 3_ 4_  5_ 2_ 5_ 4_  3_ 6_ 5_ 4_  5_ 4_ 3_ 2_ |
    1_ 6__ 6_ 7_  1 7_ 6_ 5_  4_ 3_ 2_ 6_  5_ 6_ 5_ 4_ |
}

/* ==========================================================================
   Concrete Sections (Intro & Outro)
   ========================================================================== */

/* 前奏：大提琴先演奏一次 2 小節固定低音 */
intro:Cello@|0|{
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* 尾奏：各部匯流終止於主和弦音 */
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 3--- | }
outro:Violin3@|0|{ <1*> 1--- | }
outro:Cello@|0|{   <1*> 1_--- | }

/* ==========================================================================
   S-Expression Playback Flow (Evaluated and Desugared at Compile-Time)
   ========================================================================== */

-> intro
-> (layer
     (canon Theme (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 8))
-> outro
->#
