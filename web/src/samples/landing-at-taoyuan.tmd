::SCORE::
** Landing at Taoyuan: Rhapsody for Orchestra **
~ "composer: Antigravity & zonble"
~ "arranger: Antonín Dvořák Style"
!= 96
?= F
<4/4>

/*
  Musical Cryptogram in F Major (Tonic F):
  Theme: 6_ - 1 - 2 - 3 - | 5 - 6 - 1^ - - - |

  Orchestration:
  - Woodwinds: Flute, Oboe, Clarinet
  - Brass: FrenchHorn
  - Percussion: Timpani
  - Strings: Violin1, Violin2, Viola, Cello, Contrabass

  Structure (~3 minutes, 72 bars at 96 BPM):
  1. Intro (4 bars): Dawn over the Runway (Horn & Woodwind calls, soft drone)
  2. Expo (8 bars): Full 4-voice String Fugato with Horn countermelody
  3. Woods (8 bars): Pastoral Dance (Flute & Clarinet playful woodwind dialogue)
  4. Dumka (12 bars): Melancholy Ballad in D Minor (English Horn/Viola & Cello)
  5. Slavonic (16 bars): Vivace Furiant (Syncopated fire, Timpani, Full Ensemble)
  6. Stretto (12 bars): Grand Contrapuntal Climax (Layered fugal entries)
  7. Hymn (12 bars): Sunset Landing Hymn (Broad hymnody, noble and serene resolution)
*/

/* ========================================================================= */
/* 1. INTRO (4 bars): Dawn over the Runway                                   */
/* ========================================================================= */

intro:FrenchHorn@|0|{
    <8*>
    /* Noble rustic horn call */
    1 - - - 5 - - - | 6 - 5 3 2 - - - |
    1 - 2 - 3 - 5 - | 1^ - - - 1^ - - - |
}

intro:Flute@|0|{
    <8*>
    /* Distant bird call / pastoral trill response */
    0 - - - 0 - - - | 0 - - - 0 - - - |
    5^ 6^ 5^ 3^ 2^ 3^ 5^ 3^ | 1^ - - - 1^ - - - |
}

intro:Clarinet@|0|{
    <8*>
    0 - - - 0 - - - | 0 - - - 0 - - - |
    1^ 2^ 1^ 6 5 6 1^ 6 | 5 - - - 5 - - - |
}

intro:Viola@|0|{
    <8*>
    /* Open fifth drone (F-C) */
    5_ - - - 5_ - - - | 5_ - - - 5_ - - - |
    5_ - - - 5_ - - - | 5_ - - - 5_ - - - |
}

intro:Cello@|0|{
    <8*>
    /* Deep tonic pedal */
    1_ - - - 1_ - - - | 1_ - - - 1_ - - - |
    1_ - - - 1_ - - - | 1_ - - - 1_ - - - |
}

intro:Contrabass@|0|{
    <8*>
    1__ - - - 1__ - - - | 1__ - - - 1__ - - - |
    1__ - - - 1__ - - - | 1__ - - - 1__ - - - |
}


/* ========================================================================= */
/* 2. EXPO (8 bars): Full String Fugato with Horn countermelody               */
/* ========================================================================= */

expo:Violin1@|0|{
    <8*>
    /* Bars 1-2: Subject (Dux) */
    6_ - 1 - 2 - 3 - | 5 - 6 - 1^ - - - |
    /* Bars 3-4: Syncopated Bohemian Countersubject 1 */
    3^ - 2^ 1^ 6 5 3 2 | 3 - 5 6 1^ - - - |
    /* Bars 5-6: Flowing runs */
    5^ - 6^ 5^ 3^ - 2^ 1^ | 2^ 3^ 5^ 3^ 2^ - - - |
    /* Bars 7-8: Counterpoint against Cello entry */
    1^^ - 6^ - 5^ 3^ 2^ 1^ | 2^ - 3^ - 1^ - - - |
}

expo:Violin2@|+2|{
    <8*>
    /* Bars 3-4: Answer (Comes) */
    6 - 1^ - 2^ - 3^ - | 5^ - 6^ - 1^^ - - - |
    /* Bars 5-6: Syncopated rhythm */
    1^ 1^ - 6 5 5 - 3 | 2 2 - 3 5 - - - |
    /* Bars 7-8: Harmonic support */
    3^ - 2^ - 1^ 6 5 3 | 5 - 6 - 5 - - - |
}

expo:Viola@|+4|{
    <8*>
    /* Bars 5-6: Middle voice Subject */
    6_ - 1 - 2 - 3 - | 5 - 6 - 1 - - - |
    /* Bars 7-8: Countermelody */
    3 - 2 1 6_ 5_ 3_ 2_ | 3_ - 5_ 6_ 1 - - - |
}

expo:Cello@|0|{
    <8*>
    /* Bars 1-4: Drone accompaniment */
    1_ - - - 5_ - - - | 1_ - - - 5_ - - - |
    1_ - - - 5_ - - - | 1_ - - - 5_ - - - |
    /* Bars 5-6: Soft walking */
    1_ - 3_ - 5_ - 3_ - | 2_ - 5_ - 1_ - - - |
    /* Bars 7-8: Subject in singing cello tenor */
    6__ - 1_ - 2_ - 3_ - | 5_ - 6_ - 1_ - - - |
}

expo:Contrabass@|+6|{
    <8*>
    /* Enters at Bar 7 reinforcing Cello Subject */
    6___ - 1__ - 2__ - 3__ - | 5__ - 6__ - 1__ - - - |
}

expo:FrenchHorn@|+4|{
    <8*>
    /* Warm counter-harmony backing Viola & Cello */
    1 - - - 3 - - - | 2 - - - 1 - - - |
    3 - 5 - 6 - 5 - | 4 - 3 - 1 - - - |
}


/* ========================================================================= */
/* 3. WOODS (8 bars): Pastoral Woodwind Dance                                */
/* ========================================================================= */

